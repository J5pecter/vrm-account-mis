/** Housekeeping: drop long-expired sessions and old idempotency records. Never touches business data. */
function maintenance() {
  REQ_ = newReq_();
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return;
  try {
    var cutSessions = nowMs_() - APP.SESSION_KEEP_DAYS * 86400000;
    var cutIdem = new Date(nowMs_() - APP.IDEMPOTENCY_KEEP_DAYS * 86400000).toISOString();
    rewrite_('Sessions', function (s) { return Date.parse(s.expires_at) > cutSessions; });
    rewrite_('IdempotencyRequests', function (r) { return r.created_at >= cutIdem; });
    SpreadsheetApp.flush();
  } finally { lock.releaseLock(); }
}
function rewrite_(name, keep) {
  var all = rows_(name), kept = all.filter(keep);
  if (kept.length === all.length) return;
  var s = sheet_(name), cols = SCHEMA[name];
  s.getRange(2, 1, all.length, cols.length).clearContent();
  invalidate_(name);
  REQ_.cache[name] = [];
  append_(name, kept);
}

/** Copy the whole spreadsheet to Drive (daily trigger entry point). Retention pruning only when BACKUP_RETENTION_DAYS is set. */
function backupNow() {
  REQ_ = newReq_();
  return backup_().id;
}
function backup_() {
  var id = prop_('SPREADSHEET_ID');
  if (!id) throw new Error('SPREADSHEET_ID missing');
  var stamp = Utilities.formatDate(new Date(), APP.TZ, 'yyyy-MM-dd_HHmm');
  var folderId = prop_('BACKUP_FOLDER_ID');
  var file = DriveApp.getFileById(id);
  var name = 'VRM MIS backup ' + stamp;
  var copy = folderId ? file.makeCopy(name, DriveApp.getFolderById(folderId)) : file.makeCopy(name);
  var keepDays = Number(prop_('BACKUP_RETENTION_DAYS') || 0);
  if (folderId && keepDays > 0) {
    var cutoff = nowMs_() - keepDays * 86400000, it = DriveApp.getFolderById(folderId).getFiles();
    while (it.hasNext()) {
      var f = it.next();
      if (f.getName().indexOf('VRM MIS backup ') === 0 && f.getDateCreated().getTime() < cutoff) f.setTrashed(true);
    }
  }
  Logger.log('Backup created: ' + copy.getName());
  var at = nowIso_();
  var record = function () { setMeta_('last_backup_at', at); setMeta_('last_backup_name', copy.getName()); };
  if (REQ_.inLock) record();
  else {
    var lock = LockService.getScriptLock();
    if (lock.tryLock(30000)) {
      try { REQ_.cache = {}; record(); SpreadsheetApp.flush(); } finally { lock.releaseLock(); }
    }
  }
  return { id: copy.getId(), name: copy.getName(), at: at };
}

/** Upsert one Meta key (caller holds the script lock). */
function setMeta_(key, value) {
  var row = rows_('Meta').filter(function (m) { return m.key === key; })[0];
  if (row) update_('Meta', row, { value: value, updated_at: nowIso_() });
  else append_('Meta', [{ key: key, value: value, updated_at: nowIso_() }]);
}
function getMeta_(key) {
  var row = rows_('Meta').filter(function (m) { return m.key === key; })[0];
  return row ? row.value : '';
}

/** What is scheduled, and when the last backup ran. */
function scheduleStatus_() {
  var handlers = ScriptApp.getProjectTriggers().map(function (t) { return t.getHandlerFunction(); });
  return {
    backupInstalled: handlers.indexOf('backupNow') >= 0,
    maintenanceInstalled: handlers.indexOf('maintenance') >= 0,
    backupTime: '01:00 IST daily',
    lastBackupAt: getMeta_('last_backup_at'),
    lastBackupName: getMeta_('last_backup_name'),
    backupFolderSet: !!prop_('BACKUP_FOLDER_ID'),
    retentionDays: Number(prop_('BACKUP_RETENTION_DAYS') || 0)
  };
}
function installSchedule_(user) {
  installTriggers();
  audit_(user, 'installSchedule', { entityType: 'schedule', detail: 'Daily backup at 01:00 IST and hourly maintenance installed' });
  return scheduleStatus_();
}
function runBackup_(user) {
  var b = backup_();
  audit_(user, 'runBackup', { entityType: 'backup', entityId: b.id, detail: 'Manual backup ' + b.name });
  return scheduleStatus_();
}

/** Daily 01:00 IST backup and hourly maintenance. Run once by the owner. */
function installTriggers() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (['backupNow', 'maintenance'].indexOf(t.getHandlerFunction()) >= 0) ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('backupNow').timeBased().everyDays(1).atHour(1).inTimezone(APP.TZ).create();
  ScriptApp.newTrigger('maintenance').timeBased().everyHours(1).create();
}

/** Log the integrity report (use after restore drills and migrations). */
function verifyIntegrity() {
  REQ_ = newReq_();
  var r = integrityReport_();
  Logger.log(JSON.stringify(r, null, 2));
  return r;
}
