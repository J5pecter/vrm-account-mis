/* ===================================================================== */

function userOut_(u) {
  var locked = !!u.locked_until && Date.parse(u.locked_until) > nowMs_();
  return { id: u.id, name: u.name, role: u.role, assignedVrmId: u.assigned_vrm_id, active: truthy_(u.active),
    locked: locked, mustChangePassword: truthy_(u.must_change_password), lastLoginAt: u.last_login_at, createdAt: u.created_at };
}
function listUsers_() {
  return rows_('Users').map(userOut_).sort(function (a, b) { return a.name < b.name ? -1 : 1; });
}
function findUser_(id) {
  var u = rows_('Users').filter(function (x) { return x.id === clean_(id); })[0];
  if (!u) fail_('NOT_FOUND', 'User not found.');
  return u;
}
function checkRoleAssignment_(role, vrmId) {
  if (!ROLES[role]) fail_('VALIDATION', 'Role must be admin, member or reviewer.');
  vrmId = clean_(vrmId);
  if (role === 'member' && !vrmId) fail_('VALIDATION', 'A member must be linked to a VRM.');
  if (role === 'reviewer' && vrmId) fail_('VALIDATION', 'A reviewer cannot be linked to a VRM.');
  if (vrmId) {
    var v = requireVrm_(vrmId);
    if (v.status !== 'active') fail_('CONFLICT', 'Cannot link an account to an archived VRM.');
  }
  return vrmId;
}
function activeAdminCount_(exceptId) {
  return rows_('Users').filter(function (u) { return u.role === 'admin' && truthy_(u.active) && u.id !== exceptId; }).length;
}
function createUser_(p, user) {
  var name = validatePersonName_(p.name, 'Name');
  var key = nameKey_(name);
  if (rows_('Users').some(function (u) { return u.name_key === key; })) fail_('CONFLICT', 'An account with this name already exists.');
  var role = clean_(p.role);
  var vrmId = checkRoleAssignment_(role, p.assignedVrmId);
  checkPasswordPolicy_(p.tempPassword, name);
  var f = setPasswordFields_(p.tempPassword);
  var u = { id: uuid_(), name: name, name_key: key, role: role, assigned_vrm_id: vrmId, active: 'true',
    pw_algo: f.pw_algo, salt: f.salt, password_hash: f.password_hash, must_change_password: 'true', failed_count: 0,
    locked_until: '', created_at: nowIso_(), created_by: user.id, updated_at: nowIso_(), updated_by: user.id,
    password_changed_at: f.password_changed_at, last_login_at: '' };
  append_('Users', [u]);
  audit_(user, 'createUser', { entityType: 'user', entityId: u.id, vrmId: vrmId, after: { name: name, role: role, vrmId: vrmId } });
  return { user: userOut_(rows_('Users').filter(function (x) { return x.id === u.id; })[0]) };
}
function updateUser_(p, user) {
  var u = findUser_(p.userId);
  var role = p.role !== undefined ? clean_(p.role) : u.role;
  var vrmId = checkRoleAssignment_(role, p.assignedVrmId !== undefined ? p.assignedVrmId : u.assigned_vrm_id);
  if (u.role === 'admin' && role !== 'admin' && truthy_(u.active) && activeAdminCount_(u.id) === 0) fail_('CONFLICT', 'At least one active administrator must remain.');
  var before = { role: u.role, vrmId: u.assigned_vrm_id };
  if (role === u.role && vrmId === u.assigned_vrm_id) fail_('VALIDATION', 'Nothing to change.');
  update_('Users', u, { role: role, assigned_vrm_id: vrmId, updated_at: nowIso_(), updated_by: user.id });
  var revoked = revokeUserSessions_(u.id, 'role_changed', '');
  audit_(user, 'updateUser', { entityType: 'user', entityId: u.id, before: before, after: { role: role, vrmId: vrmId }, detail: revoked + ' session(s) revoked' });
  return { user: userOut_(u) };
}
function resetUserPassword_(p, user) {
  var u = findUser_(p.userId);
  checkPasswordPolicy_(p.tempPassword, u.name);
  var f = setPasswordFields_(p.tempPassword);
  f.must_change_password = 'true';
  f.failed_count = 0;
  f.locked_until = '';
  f.updated_at = nowIso_();
  f.updated_by = user.id;
  update_('Users', u, f);
  var revoked = revokeUserSessions_(u.id, 'password_reset', '');
  audit_(user, 'resetUserPassword', { entityType: 'user', entityId: u.id, detail: 'Temporary password issued; ' + revoked + ' session(s) revoked' });
  return { user: userOut_(u) };
}
function setUserActive_(p, user) {
  var u = findUser_(p.userId);
  var active = p.active === true;
  if (truthy_(u.active) === active) fail_('VALIDATION', active ? 'Account is already active.' : 'Account is already disabled.');
  if (!active && u.id === user.id) fail_('CONFLICT', 'You cannot disable your own account.');
  if (!active && u.role === 'admin' && activeAdminCount_(u.id) === 0) fail_('CONFLICT', 'At least one active administrator must remain.');
  if (active && u.assigned_vrm_id) {
    var v = findVrmById_(u.assigned_vrm_id);
    if (!v || v.status !== 'active') fail_('CONFLICT', 'The linked VRM is archived. Restore it or change the link first.');
  }
  var why = active ? '' : reason_(p.reason);
  update_('Users', u, { active: active ? 'true' : 'false', updated_at: nowIso_(), updated_by: user.id });
  var revoked = active ? 0 : revokeUserSessions_(u.id, 'disabled', '');
  audit_(user, active ? 'enableUser' : 'disableUser', { entityType: 'user', entityId: u.id, before: { active: !active }, after: { active: active },
    detail: (why ? why + '; ' : '') + revoked + ' session(s) revoked' });
  return { user: userOut_(u) };
}
function unlockUser_(p, user) {
  var u = findUser_(p.userId);
  update_('Users', u, { failed_count: 0, locked_until: '', updated_at: nowIso_(), updated_by: user.id });
  audit_(user, 'unlockUser', { entityType: 'user', entityId: u.id });
  return { user: userOut_(u) };
}

/* ===================================================================== */
/* Audit log, admin overview, integrity                                  */
/* ===================================================================== */

function auditOut_(a, vrms) {
  var v = vrms[a.vrm_id];
  var parse = function (s) { try { return s ? JSON.parse(s) : null; } catch (x) { return null; } };
  return { id: a.id, time: a.server_timestamp, actorId: a.actor_user_id, actor: a.actor_name, role: a.actor_role,
    action: a.action, entityType: a.entity_type, entityId: a.entity_id, vrmId: a.vrm_id, vrmName: v ? v.canonical_name : '',
    before: parse(a.before), after: parse(a.after), outcome: a.outcome, requestId: a.request_id, detail: a.detail };
}
function getLogs_(p) {
  var from = optionalIsoDate_(p.from, 'From date'), to = optionalIsoDate_(p.to, 'To date');
  if (from && to && from > to) fail_('VALIDATION', 'From date is after To date.');
  var actor = clean_(p.actorId), action = clean_(p.eventAction), outcome = clean_(p.outcome);
  var list = rows_('AuditEvents').filter(function (a) {
    if (actor && a.actor_user_id !== actor) return false;
    if (action && a.action !== action) return false;
    if (outcome && a.outcome !== outcome) return false;
    if (from || to) {
      var d = istDateOf_(a.server_timestamp);
      if (from && d < from) return false;
      if (to && d > to) return false;
    }
    return true;
  }).reverse();
  var pageSize = intParam_(p.pageSize, 50, 1, APP.MAX_PAGE);
  var pages = Math.max(1, Math.ceil(list.length / pageSize));
  var page = intParam_(p.page, 1, 1, pages);
  var vrms = vrmsById_();
  var actions = {};
  rows_('AuditEvents').forEach(function (a) { actions[a.action] = true; });
  return { items: list.slice((page - 1) * pageSize, page * pageSize).map(function (a) { return auditOut_(a, vrms); }),
    total: list.length, page: page, pageSize: pageSize, pages: pages,
    actors: listUsers_().map(function (u) { return { id: u.id, name: u.name }; }), actions: Object.keys(actions).sort() };
}

function adminOverview_(user) {
  var vrms = vrmsById_(), users = usersById_();
  var since = new Date(nowMs_() - 30 * 86400000).toISOString();
  var events = rows_('AuditEvents');
  var recent = events.slice(-12).reverse().map(function (a) { return auditOut_(a, vrms); });
  var corrections = events.filter(function (a) {
    return a.server_timestamp >= since && ['correctEntry', 'softDeleteEntry', 'restoreEntry'].indexOf(a.action) >= 0 && a.outcome === 'success';
  }).reverse().slice(0, 25).map(function (a) { return auditOut_(a, vrms); });
  var backdated = {}, backdatedList = [];
  rows_('Entries').forEach(function (e) {
    if (e.status !== 'active' || !e.created_at || e.created_at < since) return;
    var created = istDateOf_(e.created_at);
    if (e.activation_date < created) {
      backdated[e.vrm_id] = (backdated[e.vrm_id] || 0) + 1;
      if (backdatedList.length < 200) backdatedList.push(entryOut_(e, users, vrms));
    }
  });
  backdatedList.sort(function (a, b) { return a.createdAt < b.createdAt ? 1 : -1; });
  var exceptions = rows_('ImportBatches').filter(function (b) { return b.started_at >= since; }).map(batchOut_)
    .filter(function (b) { return b.exceptions > 0 || b.status !== 'completed'; }).reverse().slice(0, 20);
  return {
    users: user.role === 'admin' ? listUsers_() : [],
    recent: recent,
    corrections: corrections,
    backdated: Object.keys(backdated).map(function (k) { return { vrmId: k, vrmName: vrms[k] ? vrms[k].canonical_name : '', count: backdated[k] }; }),
    backdatedEntries: backdatedList.slice(0, 50),
    importExceptions: exceptions,
    windowDays: 30
  };
}

/** Consistency checks for reconciliation and restore drills. Read-only. */
function integrityReport_() {
  var entries = rows_('Entries'), vrms = vrmsById_(), keys = {}, dupKeys = [], orphan = 0, badDate = 0, badKey = 0, future = 0;
  var today = todayIst_(), perVrm = {}, perMonth = {}, active = 0, deleted = 0;
  entries.forEach(function (e) {
    if (keys[e.code_key]) dupKeys.push(e.code_key); else keys[e.code_key] = true;
    if (!vrms[e.vrm_id]) orphan++;
    var d = checkDateShape_(e.activation_date);
    if (!d) badDate++; else if (e.activation_date > today) future++;
    var c = normCode_(e.client_code_original);
    if (!c.ok || c.key !== e.code_key) badKey++;
    if (e.status === 'active') {
      active++;
      perVrm[e.vrm_id] = (perVrm[e.vrm_id] || 0) + 1;
      var m = e.activation_date.slice(0, 7);
      perMonth[m] = (perMonth[m] || 0) + 1;
    } else deleted++;
  });
  var sumPerVrm = Object.keys(perVrm).reduce(function (s, k) { return s + perVrm[k]; }, 0);
  return {
    checkedAt: nowIso_(), entries: entries.length, active: active, deleted: deleted,
    distinctCodeKeys: Object.keys(keys).length, duplicateCodeKeys: dupKeys.length, orphanEntries: orphan,
    invalidDates: badDate, futureDates: future, codeKeyMismatches: badKey,
    teamEqualsSumOfVrms: sumPerVrm === active,
    perVrm: Object.keys(perVrm).map(function (k) { return { vrmId: k, vrmName: vrms[k] ? vrms[k].canonical_name : '(orphan)', count: perVrm[k] }; }),
    perMonth: Object.keys(perMonth).sort().map(function (k) { return { month: k, count: perMonth[k] }; }),
    ok: dupKeys.length === 0 && orphan === 0 && badDate === 0 && future === 0 && badKey === 0 && sumPerVrm === active
  };
}
function checkDateShape_(s) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return false;
  var y = Number(s.slice(0, 4)), m = Number(s.slice(5, 7)), d = Number(s.slice(8, 10));
  var t = new Date(Date.UTC(y, m - 1, d));
  return t.getUTCFullYear() === y && t.getUTCMonth() === m - 1 && t.getUTCDate() === d;
}

/* ===================================================================== */
/* Operator functions (run from the Apps Script editor, never via API)   */
/* ===================================================================== */

/**
 * Create tabs and seed an EMPTY staging spreadsheet. Safe to re-run: existing tabs are verified,
 * never overwritten; the roster is seeded only when VRMs, Entries and Users are all empty.
 */
function setup() {
  REQ_ = newReq_();
  var boundProps = PropertiesService.getScriptProperties();
  if (!boundProps.getProperty('SPREADSHEET_ID') && SpreadsheetApp.getActiveSpreadsheet) {
    // Script created inside its Sheet (clasp create --type sheets): use that Sheet as the database.
    var active = SpreadsheetApp.getActiveSpreadsheet();
    if (active) boundProps.setProperty('SPREADSHEET_ID', active.getId());
  }
  var ss = ss_();
  Object.keys(SCHEMA).forEach(function (name) {
    var s = ss.getSheetByName(name) || ss.insertSheet(name), heads = SCHEMA[name];
    if (s.getLastRow() === 0) {
      s.getRange(1, 1, s.getMaxRows(), heads.length).setNumberFormat('@');
      s.getRange(1, 1, 1, heads.length).setValues([heads]).setFontWeight('bold').setBackground('#e4eaf2');
      s.setFrozenRows(1);
    } else {
      var existing = s.getRange(1, 1, 1, heads.length).getValues()[0].map(String);
      if (existing.join('|') !== heads.join('|')) {
        throw new Error('Tab ' + name + ' has an unexpected schema. Stop: migrate it deliberately, never overwrite.');
      }
    }
    try {
      var prot = s.protect().setDescription('VRM MIS data - edit through the application only');
      var me = Session.getEffectiveUser();
      prot.addEditor(me);
      prot.removeEditors(prot.getEditors().filter(function (e) { return e.getEmail() !== me.getEmail(); }));
      if (prot.canDomainEdit()) prot.setDomainEdit(false);
    } catch (x) { console.warn('Protection not applied to ' + name + ': ' + x); }
  });
  var empty = !rows_('VRMs').length && !rows_('Entries').length && !rows_('Users').length;
  if (empty) {
    var setupUser = { id: 'setup' };
    var ids = {};
    append_('VRMs', APP.SEED_VRMS.map(function (n) {
      var id = uuid_();
      ids[nameKey_(n)] = id;
      return { id: id, canonical_name: n, name_key: nameKey_(n), status: 'active', created_at: nowIso_(), created_by: setupUser.id, updated_at: nowIso_(), updated_by: setupUser.id };
    }));
    append_('Aliases', APP.SEED_ALIASES.map(function (a) {
      return { alias_key: nameKey_(a[0]), alias_display: a[0], canonical_vrm_id: ids[nameKey_(a[1])], created_at: nowIso_(), created_by: 'setup' };
    }));
  }
  var meta = rows_('Meta').filter(function (m) { return m.key === 'schema_version'; })[0];
  if (!meta) append_('Meta', [{ key: 'schema_version', value: String(APP.SCHEMA_VERSION), updated_at: nowIso_() }]);
  var props = PropertiesService.getScriptProperties();
  if (!props.getProperty('PASSWORD_PEPPER')) props.setProperty('PASSWORD_PEPPER', uuid_() + uuid_() + uuid_());
  SpreadsheetApp.flush();
  Logger.log('VRM MIS v3 schema ready' + (empty ? ' and roster seeded' : ' (existing data untouched)') + '. Provision the first administrator next.');
}

/**
 * Create or reset one account with a temporary password (must be changed at first sign-in).
 * Used by the Sheet menu and by provisionUserFromProperties(). Returns the account name.
 */
function provisionAccount_(rawName, rawRole, rawVrm, pw) {
  REQ_ = newReq_();
  var name = validatePersonName_(rawName, 'Name');
  var role = clean_(rawRole).toLowerCase();
  var vrmName = clean_(rawVrm);
  var vrmId = '';
  if (vrmName) {
    var v = resolveVrmName_(vrmName);
    if (!v) throw new Error('VRM "' + vrmName + '" is not on the roster.');
    vrmId = v.id;
  }
  checkRoleAssignment_(role, vrmId);
  checkPasswordPolicy_(pw, name);
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    REQ_.cache = {};
    var f = setPasswordFields_(pw);
    var existing = rows_('Users').filter(function (u) { return u.name_key === nameKey_(name); })[0];
    var actor = { id: 'setup', name: 'setup', role: 'system' };
    if (existing) {
      update_('Users', existing, { role: role, assigned_vrm_id: vrmId, active: 'true', pw_algo: f.pw_algo, salt: f.salt,
        password_hash: f.password_hash, password_changed_at: f.password_changed_at, must_change_password: 'true',
        failed_count: 0, locked_until: '', updated_at: nowIso_(), updated_by: 'setup' });
      revokeUserSessions_(existing.id, 'password_reset', '');
      audit_(actor, 'provisionUser', { entityType: 'user', entityId: existing.id, detail: 'Reset by script operator' });
    } else {
      var id = uuid_();
      append_('Users', [{ id: id, name: name, name_key: nameKey_(name), role: role, assigned_vrm_id: vrmId, active: 'true',
        pw_algo: f.pw_algo, salt: f.salt, password_hash: f.password_hash, must_change_password: 'true', failed_count: 0,
        locked_until: '', created_at: nowIso_(), created_by: 'setup', updated_at: nowIso_(), updated_by: 'setup',
        password_changed_at: f.password_changed_at, last_login_at: '' }]);
      audit_(actor, 'provisionUser', { entityType: 'user', entityId: id, detail: 'Created by script operator as ' + role });
    }
    SpreadsheetApp.flush();
  } finally { lock.releaseLock(); }
  return name;
}

/**
 * Provision or reset one account from temporary Script Properties, then delete them:
 *   SETUP_NAME, SETUP_PASSWORD (12+ chars), SETUP_ROLE (admin|member|reviewer), SETUP_VRM (canonical VRM name, optional for admin).
 * The account must change the password at first sign-in. (The Sheet menu is the simpler route.)
 */
function provisionUserFromProperties() {
  var props = PropertiesService.getScriptProperties();
  try {
    var name = provisionAccount_(props.getProperty('SETUP_NAME'), props.getProperty('SETUP_ROLE'), props.getProperty('SETUP_VRM'), props.getProperty('SETUP_PASSWORD') || '');
    Logger.log('Provisioned ' + name + '. Temporary password must be changed at first sign-in.');
  } finally {
    ['SETUP_NAME', 'SETUP_PASSWORD', 'SETUP_ROLE', 'SETUP_VRM'].forEach(function (k) { props.deleteProperty(k); });
  }
}

/** Random temporary password (16 chars, unambiguous alphabet) from the platform's secure UUID generator. */
function tempPassword_() {
  var alpha = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789-!@#%';
  var hex = (uuid_() + uuid_()).replace(/-/g, '');
  var out = '';
  for (var i = 0; i < 16; i++) out += alpha[parseInt(hex.substr(i * 2, 2), 16) % alpha.length];
  return out;
}

