  var now = nowMs_();
  if (Date.parse(s.expires_at) <= now) fail_('SESSION_EXPIRED', 'Your session expired. Please sign in again.');
  var idleMin = truthy_(s.remember) ? APP.REMEMBER_IDLE_MIN : APP.SESSION_IDLE_MIN;
