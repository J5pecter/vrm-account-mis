/* ===================================================================== */
/* Audit                                                                 */
/* ===================================================================== */

function audit_(user, action, o) {
  o = o || {};
  append_('AuditEvents', [{
    id: uuid_(), server_timestamp: nowIso_(),
    actor_user_id: user ? user.id : '', actor_name: user ? user.name : '', actor_role: user ? user.role : '',
    action: action, entity_type: o.entityType || '', entity_id: o.entityId || '', vrm_id: o.vrmId || '',
    before: o.before ? JSON.stringify(o.before) : '', after: o.after ? JSON.stringify(o.after) : '',
    outcome: o.outcome || 'success', request_id: REQ_.idemKey || REQ_.serverRequestId,
    detail: safeCellText_(trunc_(o.detail || '', 1000))
  }]);
}
/** Failure-path audit; takes the lock briefly and never masks the original error. */
function auditOutside_(user, action, outcome, detail, vrmId) {
  try {
    var lock = LockService.getScriptLock();
    if (!lock.tryLock(3000)) return;
    try {
      invalidate_('AuditEvents');
      audit_(user, action, { outcome: outcome, detail: detail, vrmId: vrmId || '' });
      SpreadsheetApp.flush();
    } finally { lock.releaseLock(); }
  } catch (x) { console.warn('audit failed', String(x)); }
}
function auditDenied_(user, action, detail, vrmId) {
  if (REQ_.inLock) { audit_(user, action, { outcome: 'denied', detail: detail, vrmId: vrmId || '' }); return; }
  auditOutside_(user, action, 'denied', detail, vrmId);
}
function auditRejected_(user, action, detail) { auditOutside_(user, action, 'rejected', detail); }

/* ===================================================================== */
/* Idempotency                                                           */
/* ===================================================================== */

function idempotent_(action, p, user, fn) {
  var rid = clean_(p.requestId);
  if (!/^[A-Za-z0-9_:\-]{8,120}$/.test(rid)) fail_('BAD_REQUEST', 'A valid requestId is required for this action.');
  REQ_.idemKey = rid;
  var prior = rows_('IdempotencyRequests').filter(function (r) { return r.request_key === rid; })[0];
  if (prior) {
    if (prior.actor_user_id !== user.id || prior.action !== action) fail_('CONFLICT', 'requestId was already used for a different request.');
    var stored = JSON.parse(prior.result || '{}');
    stored.replayed = true;
    return stored;
  }
  var result = fn();
  var text = JSON.stringify(result);
  if (text.length > APP.RESULT_MAX_CHARS) {
    text = JSON.stringify({ summary: result.summary || null, truncated: true,
      note: 'Original response too large to store; re-query the ledger for per-item detail.' });
  }
  append_('IdempotencyRequests', [{ request_key: rid, actor_user_id: user.id, action: action, created_at: nowIso_(), result: text }]);
  return result;
}

/* ===================================================================== */
/* Passwords and sessions                                                */
