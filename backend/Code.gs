/* ===================================================================== */
/* Read model                                                            */
/* ===================================================================== */

function vrmOut_(v) { return { id: v.id, name: v.canonical_name, status: v.status }; }

/** Dashboard snapshot: roster + per (VRM, date) counts of active entries + zero reports. */
