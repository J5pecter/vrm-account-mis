/**
 * VRM Account MIS - Google Apps Script backend, API v3.
 *
 * Deploy against a NEW, privately owned Google Spreadsheet (see docs/06_DEPLOYMENT_RUNBOOK.md).
 * This file contains no credentials, spreadsheet IDs or client data. Secrets live in
 * Script Properties only:
 *   SPREADSHEET_ID          id of the private database spreadsheet (required)
 *   PASSWORD_PEPPER         generated by setup(); never copy it into source control
 *   MEMBER_SCOPE            'team' (default) | 'own'  - what members may read
 *   MEMBER_SEE_DUP_OWNER    'true' | 'false'          - disclose duplicate owner to members
 *   PUBLIC_LOGIN_ROSTER     'false' (default) | 'true' - list names on the sign-in screen
 *   CODE_PATTERN            optional business-approved client-code regex (anchored)
 *   BACKUP_FOLDER_ID        optional Drive folder for backupNow()
 *   BACKUP_RETENTION_DAYS   optional; when set, older backups are moved to Drive trash
 *
 * Every request is a POST whose body is JSON sent as text/plain (no CORS preflight).
 * Mutations run: authenticate -> authorize -> validate -> normalize -> idempotency check ->
 * fresh duplicate check under the script lock -> persist -> audit -> respond.
 *
 * Source file is deliberately pure ASCII.
 */

var APP = {
  VERSION: '3.0.0',
  API_VERSION: 3,
  SCHEMA_VERSION: 3,
  TZ: 'Asia/Kolkata',
  MAX_ROWS: 1500,
  MAX_BODY_CHARS: 3000000,
  MAX_LOOKUP: 500,
  MAX_PAGE: 200,
  SESSION_HOURS: 12,
  SESSION_IDLE_MIN: 120,
  REMEMBER_DAYS: 7,
  REMEMBER_IDLE_MIN: 72 * 60,
  LAST_SEEN_WRITE_MIN: 5,
  LOCK_WAIT_MS: 25000,
  LOGIN_MAX_FAILS: 5,
  LOGIN_LOCK_MIN: 15,
  PBKDF2_ITER: 1000,
  PW_MIN: 12,
  PW_MAX: 128,
  MIN_YEAR: 2000,
  IDEMPOTENCY_KEEP_DAYS: 14,
  SESSION_KEEP_DAYS: 30,
  RESULT_MAX_CHARS: 45000,
  SEED_VRMS: [
    'Parth Sharma', 'Khushi Dodiya', 'Aakansha Baranwal',
    'Manisha Mahante', 'Pavan Soni', 'Swarna Shetty',
    'Riddhi Mistry', 'Rajashri Mohandas', 'Lavina Saldanha'
  ],
  SEED_ALIASES: [
    ['swarnarekha shetty', 'Swarna Shetty'],
    ['swarnarekha divakar shetty', 'Swarna Shetty'],
    ['pavan lekhraj soni', 'Pavan Soni'],
    ['manisha hemant mahante', 'Manisha Mahante'],
    ['khushi mahesh dodiya', 'Khushi Dodiya'],
    ['aakanksha baranwal', 'Aakansha Baranwal'],
    ['parth sharma vijay', 'Parth Sharma']
  ]
};

/** Tab name -> ordered column headers. Never reorder; append new columns at the end. */
var SCHEMA = {
  Meta: ['key', 'value', 'updated_at'],
  VRMs: ['id', 'canonical_name', 'name_key', 'status', 'created_at', 'created_by', 'updated_at', 'updated_by'],
  Users: ['id', 'name', 'name_key', 'role', 'assigned_vrm_id', 'active', 'pw_algo', 'salt', 'password_hash',
    'must_change_password', 'failed_count', 'locked_until', 'created_at', 'created_by', 'updated_at',
    'updated_by', 'password_changed_at', 'last_login_at'],
  Entries: ['id', 'vrm_id', 'activation_date', 'client_code_original', 'code_key', 'status', 'source',
    'import_batch_id', 'request_id', 'created_at', 'created_by', 'updated_at', 'updated_by',
    'deleted_at', 'deleted_by', 'delete_reason'],
  Aliases: ['alias_key', 'alias_display', 'canonical_vrm_id', 'created_at', 'created_by'],
  ImportBatches: ['id', 'initiator_id', 'file_name', 'file_rows', 'client_rejected', 'mode', 'chunks_expected',
    'chunks_committed', 'received', 'accepted', 'duplicate_in_file', 'duplicate_existing', 'invalid',
    'unauthorized', 'failed', 'created_vrms', 'started_at', 'finished_at', 'status'],
  AuditEvents: ['id', 'server_timestamp', 'actor_user_id', 'actor_name', 'actor_role', 'action', 'entity_type',
    'entity_id', 'vrm_id', 'before', 'after', 'outcome', 'request_id', 'detail'],
  Sessions: ['token_hash', 'user_id', 'created_at', 'expires_at', 'last_seen_at', 'remember', 'revoked_at',
    'revoke_reason'],
  ZeroReports: ['id', 'vrm_id', 'business_date', 'actor_user_id', 'submitted_at', 'status', 'withdrawn_at',
    'withdrawn_by'],
  IdempotencyRequests: ['request_key', 'actor_user_id', 'action', 'created_at', 'result']
};
var DATE_COLUMNS = { activation_date: true, business_date: true };

var ROLES = { admin: true, member: true, reviewer: true };
var READERS = ['admin', 'member', 'reviewer'];
var WRITERS = ['admin', 'member'];
var ADMINS = ['admin'];
var AUDITORS = ['admin', 'reviewer'];

/* ===================================================================== */
/* Routing                                                                */
/* ===================================================================== */

var ROUTES = {
  health:             { auth: 'public', fn: function () { return health_(); } },
  getLoginBootstrap:  { auth: 'public', fn: function () { return loginBootstrap_(); } },
  login:              { auth: 'public', write: true, noIdem: true, fn: function (p) { return login_(p); } },
  logout:             { roles: READERS, write: true, noIdem: true, pwChange: true, fn: function (p, u, s) { return logout_(u, s); } },
  whoami:             { roles: READERS, pwChange: true, fn: function (p, u, s) { return { me: me_(u, s) }; } },
  changePassword:     { roles: READERS, write: true, noIdem: true, pwChange: true, fn: function (p, u, s) { return changePassword_(p, u, s); } },
  getData:            { roles: READERS, fn: function (p, u, s) { return snapshot_(u, s); } },
  queryEntries:       { roles: READERS, fn: function (p, u) { return queryEntries_(p, u); } },
  lookupCodes:        { roles: READERS, fn: function (p, u) { return lookupCodes_(p, u); } },
  exportReport:       { roles: READERS, write: true, noIdem: true, fn: function (p, u) { return exportReport_(p, u); } },
  getImportStatus:    { roles: READERS, fn: function (p, u) { return importStatus_(p, u); } },
  addEntries:         { roles: WRITERS, write: true, fn: function (p, u) { return addEntries_(p, u); } },
  previewImport:      { roles: WRITERS, fn: function (p, u) { return previewImport_(p, u); } },
  commitImport:       { roles: WRITERS, write: true, fn: function (p, u) { return commitImport_(p, u); } },
  cancelImport:       { roles: WRITERS, write: true, fn: function (p, u) { return cancelImport_(p, u); } },
  submitZeroReport:   { roles: WRITERS, write: true, fn: function (p, u) { return submitZeroReport_(p, u); } },
  withdrawZeroReport: { roles: WRITERS, write: true, fn: function (p, u) { return withdrawZeroReport_(p, u); } },
  addVRM:             { roles: ADMINS, write: true, fn: function (p, u) { return addVrm_(p, u); } },
  renameVRM:          { roles: ADMINS, write: true, fn: function (p, u) { return renameVrm_(p, u); } },
  archiveVRM:         { roles: ADMINS, write: true, fn: function (p, u) { return archiveVrm_(p, u); } },
  restoreVRM:         { roles: ADMINS, write: true, fn: function (p, u) { return restoreVrm_(p, u); } },
  correctEntry:       { roles: ADMINS, write: true, fn: function (p, u) { return correctEntry_(p, u); } },
  softDeleteEntry:    { roles: ADMINS, write: true, fn: function (p, u) { return softDeleteEntry_(p, u); } },
  restoreEntry:       { roles: ADMINS, write: true, fn: function (p, u) { return restoreEntry_(p, u); } },
  listAliases:        { roles: ADMINS, fn: function () { return listAliases_(); } },
  addAlias:           { roles: ADMINS, write: true, fn: function (p, u) { return addAlias_(p, u); } },
  removeAlias:        { roles: ADMINS, write: true, fn: function (p, u) { return removeAlias_(p, u); } },
  listUsers:          { roles: ADMINS, fn: function () { return { users: listUsers_() }; } },
  createUser:         { roles: ADMINS, write: true, fn: function (p, u) { return createUser_(p, u); } },
  updateUser:         { roles: ADMINS, write: true, fn: function (p, u) { return updateUser_(p, u); } },
  resetUserPassword:  { roles: ADMINS, write: true, fn: function (p, u) { return resetUserPassword_(p, u); } },
  setUserActive:      { roles: ADMINS, write: true, fn: function (p, u) { return setUserActive_(p, u); } },
  unlockUser:         { roles: ADMINS, write: true, fn: function (p, u) { return unlockUser_(p, u); } },
  integrityReport:    { roles: ADMINS, fn: function () { return integrityReport_(); } },
  getLogs:            { roles: AUDITORS, fn: function (p) { return getLogs_(p); } },
  listImportBatches:  { roles: AUDITORS, fn: function (p) { return listImportBatches_(p); } },
  getAdminOverview:   { roles: AUDITORS, fn: function (p, u) { return adminOverview_(u); } },
  scheduleStatus:     { roles: ADMINS, fn: function () { return scheduleStatus_(); } },
  installSchedule:    { roles: ADMINS, write: true, noIdem: true, fn: function (p, u) { return installSchedule_(u); } },
  runBackup:          { roles: ADMINS, write: true, noIdem: true, fn: function (p, u) { return runBackup_(u); } }
};
/** v1/v2 action names. They are rejected with an explicit upgrade code instead of a vague error. */
var LEGACY_ACTIONS = { getVrms: 1, deleteVRM: 1, deleteEntry: 1, importRows: 1 };

var REQ_ = null;   // per-request context: { cache, serverRequestId, idemKey }
var CLOCK_ = null; // test hook only; production uses the real clock

function doGet(e) {
  REQ_ = newReq_();
  return json_(envelopeOk_(health_()));
}

function doPost(e) {
  REQ_ = newReq_();
  var action = '';
  var user = null;
  try {
    var body = e && e.postData && e.postData.contents;
    if (!body) fail_('BAD_REQUEST', 'Missing request body.');
    if (body.length > APP.MAX_BODY_CHARS) fail_('PAYLOAD_TOO_LARGE', 'Request is too large. Split it into smaller batches.');
    var p;
    try { p = JSON.parse(body); } catch (x) { fail_('BAD_REQUEST', 'Malformed JSON request.'); }
    if (!p || typeof p !== 'object' || Array.isArray(p)) fail_('BAD_REQUEST', 'Request must be a JSON object.');
    action = str_(p.action);
    // v1/v2 clients authenticate with a shared password ({pw}, no token / no user name).
    if (p.pw !== undefined && p.token === undefined && (action !== 'login' || p.user === undefined)) {
      fail_('CLIENT_UPGRADE_REQUIRED', 'This dashboard version is out of date. Reload the page.');
    }
    var route = Object.prototype.hasOwnProperty.call(ROUTES, action) ? ROUTES[action] : null;
    if (!route) {
      if (LEGACY_ACTIONS[action]) {
        fail_('CLIENT_UPGRADE_REQUIRED', 'This dashboard version is out of date. Reload the page.');
      }
      fail_('UNKNOWN_ACTION', 'Unknown action.');
    }
    var session = null;
    if (route.auth !== 'public') {
      var a = authenticate_(p.token);
      user = a.user;
      session = a.session;
      if (truthy_(user.must_change_password) && !route.pwChange) {
        fail_('PASSWORD_CHANGE_REQUIRED', 'Change your temporary password to continue.');
      }
      if (route.roles.indexOf(user.role) < 0) {
        if (route.write) auditDenied_(user, action, 'Role ' + user.role + ' may not call ' + action);
        fail_('FORBIDDEN', 'You do not have permission for this action.');
      }
    }
    var data;
    if (route.write) {
      data = withLock_(function () {
        if (route.noIdem) return route.fn(p, user, session);
        return idempotent_(action, p, user, function () { return route.fn(p, user, session); });
      });
    } else {
      data = route.fn(p, user, session);
    }
    return json_(envelopeOk_(data));
  } catch (err) {
    var code = err && err.apiCode ? err.apiCode : 'INTERNAL';
    var message = err && err.apiCode ? err.message : 'Unexpected server error. Reference ' + REQ_.serverRequestId + '.';
    if (!err || !err.apiCode) {
      console.error('VRM MIS internal error', action, REQ_.serverRequestId, err && err.stack ? err.stack : String(err));
    } else if (user && ROUTES[action] && ROUTES[action].write && (code === 'VALIDATION' || code === 'CONFLICT' || code === 'NOT_FOUND')) {
      auditRejected_(user, action, code + ': ' + message);
    }
    return json_({ ok: false, apiVersion: APP.API_VERSION, requestId: REQ_.serverRequestId, serverTime: nowIso_(),
      error: { code: code, message: message, details: err && err.details ? err.details : null } });
  }
}

function newReq_() { return { cache: {}, serverRequestId: uuid_(), idemKey: '' }; }
function envelopeOk_(data) {
  return { ok: true, apiVersion: APP.API_VERSION, requestId: REQ_.serverRequestId, serverTime: nowIso_(),
    today: todayIst_(), data: data };
}
function json_(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}

/* ===================================================================== */
/* Generic helpers                                                       */
/* ===================================================================== */

function apiError_(code, message, details) {
  var e = new Error(message);
  e.apiCode = code;
  e.details = details || null;
  return e;
}
function fail_(code, message, details) { throw apiError_(code, message, details); }
function str_(v) { return v === null || v === undefined ? '' : String(v); }
function clean_(v) { return str_(v).trim(); }
function truthy_(v) { return v === true || String(v).toLowerCase() === 'true'; }
function uuid_() { return Utilities.getUuid(); }
function nowMs_() { return CLOCK_ ? CLOCK_() : Date.now(); }
function nowIso_() { return new Date(nowMs_()).toISOString(); }
function todayIst_() { return Utilities.formatDate(new Date(nowMs_()), APP.TZ, 'yyyy-MM-dd'); }
function istDateOf_(iso) {
  var t = Date.parse(iso);
  return isNaN(t) ? '' : Utilities.formatDate(new Date(t), APP.TZ, 'yyyy-MM-dd');
}
function prop_(k) { return PropertiesService.getScriptProperties().getProperty(k); }
function bytesHex_(b) {
  var out = '';
  for (var i = 0; i < b.length; i++) out += ('0' + (b[i] & 255).toString(16)).slice(-2);
  return out;
}
function sha256Hex_(s) {
  return bytesHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, s, Utilities.Charset.UTF_8));
}
function utf8Bytes_(s) { return Utilities.newBlob(str_(s)).getBytes(); }
function safeEq_(a, b) {
  a = str_(a); b = str_(b);
  var diff = a.length ^ b.length;
  for (var i = 0; i < Math.max(a.length, b.length); i++) diff |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
  return diff === 0;
}
function intParam_(v, def, min, max) {
  var n = Number(v);
  if (v === undefined || v === null || v === '' || !isFinite(n)) n = def;
  n = Math.floor(n);
  return Math.max(min, Math.min(max, n));
}
function requireString_(v, field, min, max) {
  if (typeof v !== 'string') fail_('VALIDATION', field + ' is required.');
  var s = v.trim();
  if (s.length < min || s.length > max) fail_('VALIDATION', field + ' must be ' + min + '-' + max + ' characters.');
  return s;
}
function reason_(v) {
  var s = requireString_(v === undefined ? '' : v, 'Reason', 3, 500);
  if (/[\u0000-\u001F\u007F]/.test(s.replace(/[\r\n\t]/g, ' '))) fail_('VALIDATION', 'Reason contains control characters.');
  return safeCellText_(s.replace(/\s+/g, ' '));
}
/** Free text written to the sheet must never be interpreted as a formula. */
function safeCellText_(s) { return /^[=+\-@]/.test(s) ? ' ' + s : s; }
function trunc_(s, n) { s = str_(s); return s.length > n ? s.slice(0, n) + '...' : s; }

/* ===================================================================== */
/* Domain normalisation (mirrors assets/js/core.js; parity tested)       */
/* ===================================================================== */

/** Name key: NFKC, trim, collapse whitespace, lower-case. Used for VRM names, aliases and user names. */
function nameKey_(v) { return str_(v).normalize('NFKC').replace(/\s+/g, ' ').trim().toLowerCase(); }
function displayName_(v) { return str_(v).normalize('NFKC').replace(/\s+/g, ' ').trim(); }
function validatePersonName_(raw, field) {
  var n = displayName_(raw);
  if (n.length < 2 || n.length > 100) fail_('VALIDATION', field + ' must be 2-100 characters.');
  if (!/^[\p{L}\p{M}][\p{L}\p{M} .'\-]*$/u.test(n)) fail_('VALIDATION', field + ' may contain letters, spaces, apostrophes, dots and hyphens only.');
  return n;
}

/**
 * Client code normalisation. Returns {ok, original, key, reason}.
 * original = trimmed text as typed (leading zeros preserved); key = NFKC + upper-case for uniqueness.
 */
function normCode_(raw) {
  if (typeof raw !== 'string') {
    if (typeof raw === 'number') return { ok: false, original: str_(raw), key: '', reason: 'Code must be sent as text (numbers lose leading zeros).' };
    return { ok: false, original: '', key: '', reason: 'Code is missing.' };
  }
  var original = raw.trim();
  var nf = original.normalize('NFKC').trim();
  if (!nf) return { ok: false, original: original, key: '', reason: 'Code is blank.' };
  var len = Array.from(nf).length;
  if (len > 70) return { ok: false, original: trunc_(original, 80), key: '', reason: 'Code is longer than 70 characters.' };
  if (/[\p{C}]/u.test(nf)) return { ok: false, original: trunc_(original, 80), key: '', reason: 'Code contains control or invisible characters.' };
  if (/\s/.test(nf)) return { ok: false, original: original, key: '', reason: 'Code contains a space. Separate codes with commas, semicolons or new lines.' };
  if (/^[=+\-@]/.test(nf)) return { ok: false, original: original, key: '', reason: 'Code may not start with = + - or @.' };
  var pattern = prop_('CODE_PATTERN');
  if (pattern) {
    var re;
    try { re = new RegExp(pattern, 'u'); } catch (x) { fail_('SERVER_NOT_CONFIGURED', 'CODE_PATTERN is not a valid regular expression.'); }
    if (!re.test(nf)) return { ok: false, original: original, key: '', reason: 'Code does not match the approved client-code format.' };
  }
  return { ok: true, original: original, key: nf.toUpperCase(), reason: '' };
}

/** Strict ISO YYYY-MM-DD, real calendar date, MIN_YEAR..today(IST). Returns {ok, date, code, reason}. */
function checkDate_(raw) {
  var s = clean_(raw);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return { ok: false, date: s, code: 'INVALID_DATE', reason: 'Date must be YYYY-MM-DD.' };
  var y = Number(s.slice(0, 4)), m = Number(s.slice(5, 7)), d = Number(s.slice(8, 10));
  var t = new Date(Date.UTC(y, m - 1, d));
  if (m < 1 || m > 12 || t.getUTCFullYear() !== y || t.getUTCMonth() !== m - 1 || t.getUTCDate() !== d) {
    return { ok: false, date: s, code: 'INVALID_DATE', reason: 'Not a real calendar date.' };
  }
  if (y < APP.MIN_YEAR) return { ok: false, date: s, code: 'INVALID_DATE', reason: 'Date is before ' + APP.MIN_YEAR + '.' };
  if (s > todayIst_()) return { ok: false, date: s, code: 'FUTURE_DATE', reason: 'Activation date is in the future (IST).' };
  return { ok: true, date: s, code: '', reason: '' };
}
function requireDate_(raw) {
  var c = checkDate_(raw);
  if (!c.ok) fail_('VALIDATION', c.reason);
  return c.date;
}
function optionalIsoDate_(raw, field) {
  var s = clean_(raw);
  if (!s) return '';
  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) fail_('VALIDATION', field + ' must be YYYY-MM-DD.');
  return s;
}

/* ===================================================================== */
/* Sheet table layer                                                     */
/* ===================================================================== */

function ss_() {
  if (REQ_ && REQ_.ss) return REQ_.ss;
  var id = prop_('SPREADSHEET_ID');
  if (!id) fail_('SERVER_NOT_CONFIGURED', 'Backend not configured.');
  var ss = SpreadsheetApp.openById(id);
  if (REQ_) REQ_.ss = ss;
  return ss;
}
function sheet_(name) {
  var s = ss_().getSheetByName(name);
  if (!s) fail_('SERVER_NOT_CONFIGURED', 'Database tab missing. Run setup() once.');
  return s;
}
function cellOut_(col, v) {
  if (v === null || v === undefined) return '';
  if (Object.prototype.toString.call(v) === '[object Date]') {
    return DATE_COLUMNS[col] ? Utilities.formatDate(v, APP.TZ, 'yyyy-MM-dd') : v.toISOString();
  }
  return String(v);
}
/** All rows of a tab as objects ({_row} = 1-based sheet row). Cached per request. */
function rows_(name) {
  if (!REQ_) REQ_ = newReq_();
  if (REQ_.cache[name]) return REQ_.cache[name];
  var s = sheet_(name), cols = SCHEMA[name], n = s.getLastRow(), out = [];
  if (n >= 2) {
    var vals = s.getRange(2, 1, n - 1, cols.length).getValues();
    for (var i = 0; i < vals.length; i++) {
      var o = { _row: i + 2 };
      for (var j = 0; j < cols.length; j++) o[cols[j]] = cellOut_(cols[j], vals[i][j]);
      out.push(o);
    }
  }
  REQ_.cache[name] = out;
  return out;
}
function invalidate_(name) { if (REQ_) delete REQ_.cache[name]; }
function append_(name, objects) {
  if (!objects.length) return;
  var s = sheet_(name), cols = SCHEMA[name];
  var values = objects.map(function (o) {
    return cols.map(function (h) { return o[h] === null || o[h] === undefined ? '' : String(o[h]); });
  });
  var start = s.getLastRow() + 1;
  var range = s.getRange(start, 1, values.length, cols.length);
  range.setNumberFormat('@');
  range.setValues(values);
  var cached = REQ_ && REQ_.cache[name];
  if (cached) {
    objects.forEach(function (o, i) {
      var c = { _row: start + i };
      cols.forEach(function (h, j) { c[h] = values[i][j]; });
      cached.push(c);
    });
  }
}
/** Update named fields of one cached row object in place and in the sheet (one write per contiguous run). */
function update_(name, row, fields) {
  var cols = SCHEMA[name], s = sheet_(name);
  var keys = Object.keys(fields);
  keys.forEach(function (k) {
    var j = cols.indexOf(k);
    if (j < 0) throw new Error('Unknown column ' + name + '.' + k);
    var v = fields[k] === null || fields[k] === undefined ? '' : String(fields[k]);
    var r = s.getRange(row._row, j + 1);
    r.setNumberFormat('@');
    r.setValue(v);
    row[k] = v;
  });
}
function deleteRow_(name, row) {
  sheet_(name).deleteRow(row._row);
  invalidate_(name);
}

function withLock_(fn) {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(APP.LOCK_WAIT_MS)) fail_('BUSY', 'The system is busy. No changes were saved; please retry.');
  try {
    // Everything read before the lock may be stale: re-read inside the critical section.
    REQ_.cache = {};
    REQ_.inLock = true;
    return fn();
  } finally {
    try { SpreadsheetApp.flush(); } catch (x) { console.warn('flush failed', String(x)); }
    REQ_.inLock = false;
    lock.releaseLock();
  }
}

/* ===================================================================== */
/* Lookups                                                               */
/* ===================================================================== */

function usersById_() {
  var m = {};
  rows_('Users').forEach(function (u) { m[u.id] = u; });
  return m;
}
function vrmsById_() {
  var m = {};
  rows_('VRMs').forEach(function (v) { m[v.id] = v; });
  return m;
}
function findVrmById_(id) {
  var s = clean_(id);
  if (!s) return null;
  return rows_('VRMs').filter(function (v) { return v.id === s; })[0] || null;
}
function requireVrm_(id) {
  var v = findVrmById_(id);
  if (!v) fail_('NOT_FOUND', 'VRM not found.');
  return v;
}
/** Resolve a typed/imported VRM name through canonical names then aliases. */
function resolveVrmName_(raw) {
  var k = nameKey_(raw);
  if (!k) return null;
  var vrms = rows_('VRMs');
  var direct = vrms.filter(function (v) { return v.name_key === k; })[0];
