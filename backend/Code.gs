  var vrms = rows_('VRMs').filter(function (v) { return canReadVrm_(user, v.id); });
  var visible = {};
  vrms.forEach(function (v) { visible[v.id] = true; });
  var grouped = {}, total = 0;
  rows_('Entries').forEach(function (e) {
    if (e.status !== 'active' || !visible[e.vrm_id]) return;
    var k = e.vrm_id + '|' + e.activation_date;
