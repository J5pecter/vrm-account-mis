  }).map(function (v) { return { vrmId: v.id, vrmName: v.canonical_name, status: v.status, count: per[v.id] || 0 }; });
  summary.sort(function (a, b) { return b.count - a.count || (a.vrmName < b.vrmName ? -1 : 1); });
  var total = summary.reduce(function (s, x) { return s + x.count; }, 0);
  if (total !== rows.length) fail_('INTERNAL', 'Export reconciliation failed; no file produced.');
  audit_(user, 'exportReport', { entityType: 'report', vrmId: vrmId,
    detail: 'Exported ' + rows.length + ' rows; period ' + period.kind + ' ' + period.from + '..' + period.to });
  return {
    asOf: nowIso_(), period: period, vrmId: vrmId, total: total, summary: summary,
    detail: rows.map(function (e) {
      var v = vrms[e.vrm_id], cu = users[e.created_by];
      return { date: e.activation_date, vrmName: v ? v.canonical_name : '', code: e.client_code_original,
        source: e.source, batchId: e.import_batch_id, createdAt: e.created_at, createdBy: cu ? cu.name : '' };
    })
  };
}

/* ===================================================================== */
/* Manual entry                                                          */
/* ===================================================================== */

function addEntries_(p, user) {
  var date = requireDate_(p.date);
  var vrm = requireVrm_(p.vrmId);
  requireWriteVrm_(user, vrm, 'addEntries');
  if (vrm.status !== 'active') fail_('CONFLICT', 'This VRM is archived and cannot receive new entries.');
  if (!Array.isArray(p.codes) || !p.codes.length) fail_('VALIDATION', 'Enter at least one client code.');
  if (p.codes.length > APP.MAX_ROWS) fail_('VALIDATION', 'Submit at most ' + APP.MAX_ROWS + ' codes at a time.');
  var idx = entryIndex_(), vrms = vrmsById_(), seen = {}, add = [], results = [];
  var sum = { received: p.codes.length, added: 0, duplicateInPaste: 0, duplicateExisting: 0, invalid: 0, failed: 0, recovered: 0 };
  p.codes.forEach(function (raw, i) {
    var c = normCode_(raw);
    if (!c.ok) { sum.invalid++; results.push({ i: i, input: c.original, status: 'INVALID', reason: c.reason }); return; }
    if (seen[c.key] !== undefined) {
      sum.duplicateInPaste++;
      results.push({ i: i, input: c.original, status: 'DUPLICATE_IN_PASTE', reason: 'Repeated in this submission.' });
      return;
    }
    seen[c.key] = i;
    var ex = idx[c.key];
    if (ex) {
      if (ex.request_id && ex.request_id === REQ_.idemKey) {
        sum.added++; sum.recovered++;
        results.push({ i: i, input: c.original, status: 'ADDED', entryId: ex.id, recovered: true });
        return;
      }
      sum.duplicateExisting++;
      var r = { i: i, input: c.original, status: 'DUPLICATE_EXISTING',
        reason: ex.status === 'active' ? 'Already recorded.' : 'Reserved by a deleted record; ask an administrator to restore it.' };
      if (discloseOwner_(user, ex)) {
        var ov = vrms[ex.vrm_id];
        r.owner = { vrmName: ov ? ov.canonical_name : '', date: ex.activation_date, status: ex.status };
      }
      results.push(r);
      return;
    }
    var e = { id: uuid_(), vrm_id: vrm.id, activation_date: date, client_code_original: c.original, code_key: c.key,
      status: 'active', source: 'manual', import_batch_id: '', request_id: REQ_.idemKey, created_at: nowIso_(),
      created_by: user.id, updated_at: '', updated_by: '', deleted_at: '', deleted_by: '', delete_reason: '' };
    add.push(e);
    idx[c.key] = e;
    sum.added++;
    results.push({ i: i, input: c.original, status: 'ADDED', entryId: e.id });
  });
  append_('Entries', add);
  audit_(user, 'addEntries', { entityType: 'request', entityId: REQ_.idemKey, vrmId: vrm.id,
    after: { date: date, added: sum.added },
    detail: 'Added ' + sum.added + (sum.recovered ? ' (' + sum.recovered + ' recovered from an interrupted attempt)' : '') +
      '; duplicate in paste ' + sum.duplicateInPaste + '; already recorded ' + sum.duplicateExisting + '; invalid ' + sum.invalid +
      (date < todayIst_() ? '; backdated to ' + date : '') });
  return { summary: sum, results: results, vrmId: vrm.id, date: date };
}

/* ===================================================================== */
/* Import                                                                */
/* ===================================================================== */

function importRowsParam_(p) {
  if (!Array.isArray(p.rows) || !p.rows.length) fail_('VALIDATION', 'No rows to import.');
  if (p.rows.length > APP.MAX_ROWS) fail_('PAYLOAD_TOO_LARGE', 'Send at most ' + APP.MAX_ROWS + ' rows per request.');
  return p.rows.map(function (r, i) {
    r = r && typeof r === 'object' ? r : {};
    return { row: intParam_(r.row, i + 1, 1, 10000000), vrm: str_(r.vrm), date: str_(r.date), code: r.code };
  });
}

/**
 * Classify import rows. When commit=true new entries are appended (caller holds the lock).
 * Statuses: ACCEPTED, DUPLICATE_IN_FILE, DUPLICATE_EXISTING, INVALID_CODE, INVALID_DATE, FUTURE_DATE,
 * UNKNOWN_VRM, ARCHIVED_VRM, UNAUTHORIZED_VRM.
 */
function classifyRows_(rows, user, opts) {
  var idx = entryIndex_(), vrmsMap = vrmsById_(), seen = {}, results = [], add = [];
  var newNames = {};
  rows.forEach(function (r) {
    var res = { row: r.row, input: '', status: '', reason: '' };
    var c = normCode_(r.code);
    res.input = c.original;
    var v = resolveVrmName_(r.vrm);
    if (!v && opts.approved && opts.approved[nameKey_(r.vrm)]) v = opts.approved[nameKey_(r.vrm)];
    if (!c.ok) { res.status = 'INVALID_CODE'; res.reason = c.reason; results.push(res); return; }
    var d = checkDate_(r.date);
    if (!d.ok) { res.status = d.code; res.reason = d.reason; results.push(res); return; }
    if (!v) {
      var nk = nameKey_(r.vrm);
      res.status = 'UNKNOWN_VRM';
      res.reason = nk ? 'VRM "' + trunc_(displayName_(r.vrm), 60) + '" is not on the roster.' : 'VRM is blank.';
      if (nk && user.role === 'admin') { res.canCreate = true; newNames[nk] = displayName_(r.vrm); }
      results.push(res);
      return;
    }
    res.vrmId = v.id;
    res.vrmName = v.canonical_name;
    if (!canWriteVrm_(user, v.id)) { res.status = 'UNAUTHORIZED_VRM'; res.reason = 'You may only import rows for your own VRM.'; results.push(res); return; }
    if (v.status !== 'active') { res.status = 'ARCHIVED_VRM'; res.reason = 'VRM is archived.'; results.push(res); return; }
    if (seen[c.key]) { res.status = 'DUPLICATE_IN_FILE'; res.reason = 'Same code appears on row ' + seen[c.key] + '.'; results.push(res); return; }
    seen[c.key] = r.row;
    var ex = idx[c.key];
    if (ex) {
      if (opts.commit && ex.request_id && ex.request_id === REQ_.idemKey) {
        res.status = 'ACCEPTED'; res.entryId = ex.id; res.recovered = true; results.push(res); return;
      }
      if (opts.batchId && ex.import_batch_id === opts.batchId) {
        res.status = 'DUPLICATE_IN_FILE'; res.reason = 'Same code was imported earlier in this file.'; results.push(res); return;
      }
      res.status = 'DUPLICATE_EXISTING';
      res.reason = ex.status === 'active' ? 'Already recorded.' : 'Reserved by a deleted record.';
      if (discloseOwner_(user, ex)) {
        var ov = vrmsMap[ex.vrm_id];
        res.owner = { vrmName: ov ? ov.canonical_name : '', date: ex.activation_date, status: ex.status };
      }
      results.push(res);
      return;
    }
    res.status = 'ACCEPTED';
    if (opts.commit) {
      var e = { id: uuid_(), vrm_id: v.id, activation_date: d.date, client_code_original: c.original, code_key: c.key,
        status: 'active', source: opts.source || 'import', import_batch_id: opts.batchId, request_id: REQ_.idemKey,
        created_at: nowIso_(), created_by: user.id, updated_at: '', updated_by: '', deleted_at: '', deleted_by: '', delete_reason: '' };
      add.push(e);
      idx[c.key] = e;
      res.entryId = e.id;
    }
    results.push(res);
  });
  var sum = { received: rows.length, accepted: 0, duplicateInFile: 0, duplicateExisting: 0, invalid: 0, unauthorized: 0, recovered: 0 };
  results.forEach(function (r) {
    if (r.status === 'ACCEPTED') { sum.accepted++; if (r.recovered) sum.recovered++; }
    else if (r.status === 'DUPLICATE_IN_FILE') sum.duplicateInFile++;
    else if (r.status === 'DUPLICATE_EXISTING') sum.duplicateExisting++;
    else if (r.status === 'UNAUTHORIZED_VRM') sum.unauthorized++;
    else sum.invalid++;
  });
  return { results: results, add: add, summary: sum,
    newVrmNames: Object.keys(newNames).map(function (k) { return newNames[k]; }) };
}

function previewImport_(p, user) {
  var rows = importRowsParam_(p);
  var out = classifyRows_(rows, user, { commit: false, batchId: clean_(p.batchId) });
  return { summary: out.summary, results: out.results, newVrmNames: out.newVrmNames };
}

function batchRow_(id) { return rows_('ImportBatches').filter(function (b) { return b.id === id; })[0] || null; }

function commitImport_(p, user) {
  var batchId = clean_(p.batchId);
  if (!/^[A-Za-z0-9\-]{8,64}$/.test(batchId)) fail_('BAD_REQUEST', 'batchId is required.');
  var chunkCount = intParam_(p.chunkCount, 1, 1, 10000);
  var chunkIndex = intParam_(p.chunkIndex, 0, 0, chunkCount - 1);
  var rows = importRowsParam_(p);
  var batch = batchRow_(batchId);
  if (batch) {
    if (batch.initiator_id !== user.id && user.role !== 'admin') fail_('FORBIDDEN', 'This import belongs to another user.');
    if (batch.status === 'cancelled') fail_('CONFLICT', 'This import was cancelled.');
    if (batch.status === 'completed') fail_('CONFLICT', 'This import is already complete.');
    if (String(batch.chunks_committed).split(',').indexOf(String(chunkIndex)) >= 0) fail_('CONFLICT', 'This part of the import was already committed.');
  } else {
    var mode = clean_(p.mode) === 'list' ? 'list' : 'structured';
    batch = { id: batchId, initiator_id: user.id, file_name: safeCellText_(trunc_(clean_(p.fileName).replace(/[\u0000-\u001F]/g, ''), 120)),
      file_rows: intParam_(p.fileRows, rows.length, 0, 10000000), client_rejected: intParam_(p.clientRejected, 0, 0, 10000000),
      mode: mode, chunks_expected: chunkCount, chunks_committed: '', received: 0, accepted: 0, duplicate_in_file: 0,
      duplicate_existing: 0, invalid: 0, unauthorized: 0, failed: 0, created_vrms: 0, started_at: nowIso_(),
      finished_at: '', status: 'in_progress' };
    append_('ImportBatches', [batch]);
    batch = batchRow_(batchId);
    audit_(user, 'importStarted', { entityType: 'importBatch', entityId: batchId,
      detail: 'File rows ' + batch.file_rows + '; rejected before upload ' + batch.client_rejected + '; parts ' + chunkCount });
  }
  // Admin-approved creation of VRMs that are not on the roster.
  var approved = {}, created = [];
  if (Array.isArray(p.approveNewVrms) && p.approveNewVrms.length) {
    if (user.role !== 'admin') {
      auditDenied_(user, 'commitImport', 'Member attempted to create VRMs during import');
      fail_('FORBIDDEN', 'Only administrators can add VRMs.');
    }
    p.approveNewVrms.slice(0, 50).forEach(function (raw) {
      if (resolveVrmName_(raw)) return;
      var name = validatePersonName_(raw, 'New VRM name');
      var v = createVrmRow_(name, user);
      approved[v.name_key] = v;
      created.push(name);
      audit_(user, 'addVRM', { entityType: 'vrm', entityId: v.id, vrmId: v.id, after: { name: name },
        detail: 'Created during import ' + batchId });
    });
  }
  var out = classifyRows_(rows, user, { commit: true, batchId: batchId, approved: approved, source: 'import' });
  append_('Entries', out.add);
  var s = out.summary;
  var committed = batch.chunks_committed ? batch.chunks_committed.split(',') : [];
  committed.push(String(chunkIndex));
  var done = committed.length >= Number(batch.chunks_expected);
  update_('ImportBatches', batch, {
    chunks_committed: committed.join(','),
    received: Number(batch.received) + s.received, accepted: Number(batch.accepted) + s.accepted,
    duplicate_in_file: Number(batch.duplicate_in_file) + s.duplicateInFile,
    duplicate_existing: Number(batch.duplicate_existing) + s.duplicateExisting,
    invalid: Number(batch.invalid) + s.invalid, unauthorized: Number(batch.unauthorized) + s.unauthorized,
    created_vrms: Number(batch.created_vrms) + created.length,
    status: done ? 'completed' : 'in_progress', finished_at: done ? nowIso_() : ''
  });
  audit_(user, 'importChunk', { entityType: 'importBatch', entityId: batchId,
    detail: 'Part ' + (chunkIndex + 1) + '/' + chunkCount + ': received ' + s.received + ', accepted ' + s.accepted +
      ', duplicate in file ' + s.duplicateInFile + ', already recorded ' + s.duplicateExisting + ', invalid ' + s.invalid +
      ', unauthorised ' + s.unauthorized + (created.length ? ', new VRMs ' + created.length : '') });
  return { summary: s, results: out.results, batch: batchOut_(batch), createdVrms: created };
}

function cancelImport_(p, user) {
  var batch = batchRow_(clean_(p.batchId));
  if (!batch) fail_('NOT_FOUND', 'Import not found.');
  if (batch.initiator_id !== user.id && user.role !== 'admin') fail_('FORBIDDEN', 'This import belongs to another user.');
  if (batch.status !== 'in_progress') fail_('CONFLICT', 'Only an import in progress can be cancelled.');
  update_('ImportBatches', batch, { status: 'cancelled', finished_at: nowIso_() });
  audit_(user, 'importCancelled', { entityType: 'importBatch', entityId: batch.id,
    detail: 'Cancelled after ' + (batch.chunks_committed ? batch.chunks_committed.split(',').length : 0) + ' of ' +
      batch.chunks_expected + ' parts; ' + batch.accepted + ' rows already saved remain recorded' });
  return { batch: batchOut_(batch) };
}

function batchOut_(b) {
  var u = usersById_()[b.initiator_id];
  var n = function (k) { return Number(b[k]) || 0; };
  return { id: b.id, initiator: u ? u.name : '', fileName: b.file_name, fileRows: n('file_rows'),
    clientRejected: n('client_rejected'), mode: b.mode, chunksExpected: n('chunks_expected'),
    chunksCommitted: b.chunks_committed ? b.chunks_committed.split(',').map(Number) : [],
    received: n('received'), accepted: n('accepted'), duplicateInFile: n('duplicate_in_file'),
    duplicateExisting: n('duplicate_existing'), invalid: n('invalid'), unauthorized: n('unauthorized'),
    failed: n('failed'), createdVrms: n('created_vrms'), startedAt: b.started_at, finishedAt: b.finished_at,
    status: b.status,
    exceptions: n('client_rejected') + n('duplicate_in_file') + n('duplicate_existing') + n('invalid') + n('unauthorized') + n('failed') };
}

function importStatus_(p, user) {
  var b = batchRow_(clean_(p.batchId));
  if (!b) fail_('NOT_FOUND', 'Import not found.');
  if (b.initiator_id !== user.id && user.role === 'member') fail_('FORBIDDEN', 'This import belongs to another user.');
  return { batch: batchOut_(b) };
}

function listImportBatches_(p) {
  var list = rows_('ImportBatches').slice().reverse();
  var pageSize = intParam_(p.pageSize, 25, 1, 100), page = intParam_(p.page, 1, 1, 100000);
  return { items: list.slice((page - 1) * pageSize, page * pageSize).map(batchOut_), total: list.length, page: page, pageSize: pageSize };
}

/* ===================================================================== */
/* Zero reports                                                          */
/* ===================================================================== */

function submitZeroReport_(p, user) {
  var vrm = requireVrm_(p.vrmId);
  requireWriteVrm_(user, vrm, 'submitZeroReport');
  if (vrm.status !== 'active') fail_('CONFLICT', 'This VRM is archived.');
  var date = requireDate_(p.date);
  var hasEntries = rows_('Entries').some(function (e) { return e.status === 'active' && e.vrm_id === vrm.id && e.activation_date === date; });
  if (hasEntries) fail_('CONFLICT', 'Activations are already recorded for this date, so it cannot be reported as zero.');
  var existing = rows_('ZeroReports').filter(function (z) { return z.vrm_id === vrm.id && z.business_date === date && z.status === 'active'; })[0];
  if (existing) return { zeroReport: { vrmId: vrm.id, date: date, submittedAt: existing.submitted_at }, alreadyReported: true };
  var z = { id: uuid_(), vrm_id: vrm.id, business_date: date, actor_user_id: user.id, submitted_at: nowIso_(), status: 'active', withdrawn_at: '', withdrawn_by: '' };
  append_('ZeroReports', [z]);
  audit_(user, 'submitZeroReport', { entityType: 'zeroReport', entityId: z.id, vrmId: vrm.id, after: { date: date }, detail: 'Confirmed zero activations for ' + date });
  return { zeroReport: { vrmId: vrm.id, date: date, submittedAt: z.submitted_at } };
}

function withdrawZeroReport_(p, user) {
  var vrm = requireVrm_(p.vrmId);
  requireWriteVrm_(user, vrm, 'withdrawZeroReport');
  var date = requireDate_(p.date);
  var z = rows_('ZeroReports').filter(function (x) { return x.vrm_id === vrm.id && x.business_date === date && x.status === 'active'; })[0];
  if (!z) fail_('NOT_FOUND', 'No zero report for that date.');
  update_('ZeroReports', z, { status: 'withdrawn', withdrawn_at: nowIso_(), withdrawn_by: user.id });
  audit_(user, 'withdrawZeroReport', { entityType: 'zeroReport', entityId: z.id, vrmId: vrm.id, before: { date: date, status: 'active' }, after: { status: 'withdrawn' } });
  return { withdrawn: true };
}

/* ===================================================================== */
/* VRM roster                                                            */
/* ===================================================================== */

function assertNameFree_(name, exceptVrmId) {
  var k = nameKey_(name);
  var clash = rows_('VRMs').filter(function (v) { return v.name_key === k && v.id !== exceptVrmId; })[0];
  if (clash) fail_('CONFLICT', clash.status === 'archived' ? 'An archived VRM already uses this name. Restore it instead.' : 'A VRM with this name already exists.');
  var alias = rows_('Aliases').filter(function (a) { return a.alias_key === k && a.canonical_vrm_id !== exceptVrmId; })[0];
  if (alias) fail_('CONFLICT', 'This name is an alias of another VRM. Remove the alias first.');
}
function createVrmRow_(name, user) {
  assertNameFree_(name, '');
  var v = { id: uuid_(), canonical_name: name, name_key: nameKey_(name), status: 'active', created_at: nowIso_(),
    created_by: user.id, updated_at: nowIso_(), updated_by: user.id };
  append_('VRMs', [v]);
  return rows_('VRMs').filter(function (x) { return x.id === v.id; })[0];
}
function addVrm_(p, user) {
  var name = validatePersonName_(p.name, 'VRM name');
  var v = createVrmRow_(name, user);
  audit_(user, 'addVRM', { entityType: 'vrm', entityId: v.id, vrmId: v.id, after: { name: name } });
  return { vrm: vrmOut_(v) };
}
function renameVrm_(p, user) {
  var v = requireVrm_(p.vrmId);
  var name = validatePersonName_(p.newName, 'New name');
  if (name === v.canonical_name) fail_('VALIDATION', 'The new name is the same as the current name.');
  assertNameFree_(name, v.id);
  var before = v.canonical_name;
  update_('VRMs', v, { canonical_name: name, name_key: nameKey_(name), updated_at: nowIso_(), updated_by: user.id });
  // Keep the previous spelling resolvable for older import files.
  var oldKey = nameKey_(before);
  if (oldKey !== nameKey_(name) && !rows_('Aliases').some(function (a) { return a.alias_key === oldKey; })) {
    append_('Aliases', [{ alias_key: oldKey, alias_display: before, canonical_vrm_id: v.id, created_at: nowIso_(), created_by: user.id }]);
  }
  // A rename may make an alias identical to the new canonical name; that alias is now redundant.
  rows_('Aliases').filter(function (a) { return a.alias_key === nameKey_(name) && a.canonical_vrm_id === v.id; })
    .forEach(function (a) { deleteRow_('Aliases', a); });
  audit_(user, 'renameVRM', { entityType: 'vrm', entityId: v.id, vrmId: v.id, before: { name: before }, after: { name: name } });
  return { vrm: vrmOut_(v) };
}
function archiveVrm_(p, user) {
  var v = requireVrm_(p.vrmId);
  var why = reason_(p.reason);
  if (v.status === 'archived') fail_('CONFLICT', 'VRM is already archived.');
  var assigned = rows_('Users').filter(function (u) { return u.assigned_vrm_id === v.id && truthy_(u.active); });
  if (assigned.length) fail_('CONFLICT', 'Deactivate or reassign the account linked to this VRM (' + assigned.map(function (u) { return u.name; }).join(', ') + ') before archiving.');
  update_('VRMs', v, { status: 'archived', updated_at: nowIso_(), updated_by: user.id });
  audit_(user, 'archiveVRM', { entityType: 'vrm', entityId: v.id, vrmId: v.id, before: { status: 'active' }, after: { status: 'archived' }, detail: why });
  return { vrm: vrmOut_(v) };
}
function restoreVrm_(p, user) {
  var v = requireVrm_(p.vrmId);
  if (v.status !== 'archived') fail_('CONFLICT', 'VRM is not archived.');
  update_('VRMs', v, { status: 'active', updated_at: nowIso_(), updated_by: user.id });
  audit_(user, 'restoreVRM', { entityType: 'vrm', entityId: v.id, vrmId: v.id, before: { status: 'archived' }, after: { status: 'active' } });
  return { vrm: vrmOut_(v) };
}

/* ===================================================================== */
/* Corrections                                                           */
/* ===================================================================== */

function correctEntry_(p, user) {
  var e = findEntry_(p.entryId);
  var why = reason_(p.reason);
  if (e.status !== 'active') fail_('CONFLICT', 'Restore this entry before correcting it.');
  var before = { vrmId: e.vrm_id, date: e.activation_date };
  var upd = {};
  if (p.vrmId !== undefined && clean_(p.vrmId) && clean_(p.vrmId) !== e.vrm_id) {
    var v = requireVrm_(p.vrmId);
    if (v.status !== 'active') fail_('CONFLICT', 'Cannot move an entry to an archived VRM.');
    upd.vrm_id = v.id;
  }
  if (p.date !== undefined && clean_(p.date) && clean_(p.date) !== e.activation_date) upd.activation_date = requireDate_(p.date);
  if (!Object.keys(upd).length) fail_('VALIDATION', 'Nothing to change.');
  upd.updated_at = nowIso_();
  upd.updated_by = user.id;
  update_('Entries', e, upd);
  audit_(user, 'correctEntry', { entityType: 'entry', entityId: e.id, vrmId: e.vrm_id, before: before,
    after: { vrmId: e.vrm_id, date: e.activation_date }, detail: why });
  return { entry: entryOut_(e, usersById_(), vrmsById_()) };
}
function softDeleteEntry_(p, user) {
  var e = findEntry_(p.entryId);
  var why = reason_(p.reason);
  if (e.status !== 'active') fail_('CONFLICT', 'Entry is already deleted.');
  update_('Entries', e, { status: 'deleted', deleted_at: nowIso_(), deleted_by: user.id, delete_reason: why });
  audit_(user, 'softDeleteEntry', { entityType: 'entry', entityId: e.id, vrmId: e.vrm_id, before: { status: 'active' }, after: { status: 'deleted' }, detail: why });
  return { entry: entryOut_(e, usersById_(), vrmsById_()) };
}
function restoreEntry_(p, user) {
  var e = findEntry_(p.entryId);
  var why = reason_(p.reason);
  if (e.status !== 'deleted') fail_('CONFLICT', 'Entry is not deleted.');
  var hasZero = rows_('ZeroReports').filter(function (z) { return z.vrm_id === e.vrm_id && z.business_date === e.activation_date && z.status === 'active'; });
  update_('Entries', e, { status: 'active', deleted_at: '', deleted_by: '', delete_reason: '', updated_at: nowIso_(), updated_by: user.id });
