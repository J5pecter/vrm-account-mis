  var zero = rows_('ZeroReports').filter(function (z) { return z.status === 'active' && visible[z.vrm_id]; })
    .map(function (z) { return [z.vrm_id, z.business_date]; });
  return {
    me: me_(user, session),
    config: { memberScope: memberScope_(), maxRowsPerRequest: APP.MAX_ROWS, timeZone: APP.TZ,
      minPasswordLength: APP.PW_MIN },
